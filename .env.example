# Copy to .env, fill OPENAI_API_KEY, then run python3 scripts/demo/run.py.
# The demo server reads this file automatically (environment exports take precedence).
# Image generation runs only when the result-card button is clicked.
OPENAI_API_KEY=

# Optional demo scene-image settings. The API key is the only required setting.
HVF_SCENE_IMAGE_MODEL=gpt-image-2.5-sunburst
HVF_SCENE_IMAGE_QUALITY=medium
HVF_SCENE_IMAGE_SIZE=1536x1024
HVF_SCENE_IMAGE_ENABLED=true

# The settings below belong ONLY to the separate citywide prototype adapters.
# They do not gate the demo scene-image module above.
# Both this switch AND configs/prototype.json ai.enabled must be true.
# A positive ai.daily_usd and exact, recently verified pricing records are also required.
HVF_AI_ENABLED=false
HVF_AI_KILL_SWITCH=false

# Select IDs available to your own API project; no model is selected implicitly.
HVF_TEXT_MODEL=
HVF_IMAGE_MODEL=

# No storage override can raise the hard 20,000,000,000-byte ceiling.
